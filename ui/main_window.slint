import "../assets/fonts/Inter-Variable.ttf";
import { IconButton } from "components/icon_button.slint";
import { CalculatorView } from "views/calculator_view.slint";
import { ConverterView } from "views/converter_view.slint";
import { ShortcutsView } from "views/shortcuts_view.slint";
import { AboutView } from "views/about_view.slint";
import { HistoryPanel } from "views/history_panel.slint";
import { Sidebar } from "views/sidebar.slint";

export component MainWindow inherits Window {
    in-out property <string> active-view: "calculator";
    in-out property <bool> sidebar-open: false;
    in-out property <bool> history-open: false;

    in property <string> display-text: "0";
    in property <string> equation-text: "";
    in property <string> active-operator: "";
    in property <string> clear-label: "AC";
    in property <int> display-font-size: 52;
    in property <[string]> history-equations;
    in property <[string]> history-results;

    in property <string> category-title: "Length";
    in property <string> input-value: "1";
    in property <string> output-value: "3.2808399";
    in property <string> from-unit: "Meter";
    in property <string> to-unit: "Foot";
    in-out property <int> from-unit-index: 0;
    in-out property <int> to-unit-index: 0;
    in property <[string]> unit-options;
    in property <string> relation-text: "1 Meter = 3.2808399 Foot";

    callback button-pressed(string);
    callback converter-button-pressed(string);
    callback category-selected(string);
    callback standard-selected();
    callback from-unit-selected(string);
    callback to-unit-selected(string);
    callback swap-units-pressed();
    callback shortcuts-selected();
    callback clear-history-requested();
    callback paste-requested();

    title: "Rustic Calculator";
    icon: @image-url("../assets/calculator.png");
    background: #202020;
    default-font-family: "Inter";
    forward-focus: keyboard-focus;

    property <length> default-width: 400px;
    property <length> default-height: 620px;
    property <length> min-window-width: 360px;
    property <length> min-window-height: 560px;
    property <length> max-window-width: 900px;
    property <length> max-window-height: 1000px;
    property <length> expanded-min-width: 620px;
    property <length> window-width: content.width;
    property <length> window-height: content.height;
    property <length> history-panel-width: root.history-open ? min(320px, max(260px, root.window-width - root.default-width)) : 0px;
    property <length> content-width: root.active-view == "calculator" && root.history-open ? root.window-width - root.history-panel-width : root.window-width;
    property <length> margin: max(6px, min(12px, root.content-width / 48));
    property <length> display-margin: max(18px, min(28px, root.content-width / 18));
    property <length> toolbar-margin: max(16px, min(24px, root.content-width / 24));
    property <length> gap: 3px;
    property <length> key-width: (root.content-width - (root.margin * 2) - (root.gap * 3)) / 4;
    property <length> memory-width: (root.content-width - (root.margin * 2) - (root.gap * 5)) / 6;
    property <length> converter-key-width: (root.window-width - (root.margin * 2) - (root.gap * 2)) / 3;
    property <length> converter-wide-key-width: root.converter-key-width * 2 + root.gap;

    function toggle-history() {
        root.history-open = !root.history-open;
        if root.history-open {
            root.width = max(root.window-width, root.default-width + root.history-panel-width);
        } else {
            root.width = min(root.window-width, root.default-width);
        }
    }

    function collapse-history() {
        if root.history-open {
            root.width = min(root.window-width, root.default-width);
        }
        root.history-open = false;
    }

    function handle-key(event: KeyEvent) -> EventResult {
        if event.modifiers.control && !event.modifiers.shift && !event.modifiers.alt && !event.modifiers.meta && (event.text == "v" || event.text == "V") {
            root.paste-requested();
            return accept;
        }

        if root.active-view == "calculator" {
            if event.text == "0" { root.button-pressed("0"); return accept; }
            if event.text == "1" { root.button-pressed("1"); return accept; }
            if event.text == "2" { root.button-pressed("2"); return accept; }
            if event.text == "3" { root.button-pressed("3"); return accept; }
            if event.text == "4" { root.button-pressed("4"); return accept; }
            if event.text == "5" { root.button-pressed("5"); return accept; }
            if event.text == "6" { root.button-pressed("6"); return accept; }
            if event.text == "7" { root.button-pressed("7"); return accept; }
            if event.text == "8" { root.button-pressed("8"); return accept; }
            if event.text == "9" { root.button-pressed("9"); return accept; }
            if event.text == "." { root.button-pressed("."); return accept; }
            if event.text == "+" { root.button-pressed("+"); return accept; }
            if event.text == "-" { root.button-pressed("-"); return accept; }
            if event.text == "*" { root.button-pressed("x"); return accept; }
            if event.text == "/" { root.button-pressed("/"); return accept; }
            if event.text == "%" { root.button-pressed("%"); return accept; }
            if event.text == "=" || event.text == Key.Return { root.button-pressed("="); return accept; }
            if event.text == Key.Backspace { root.button-pressed("Back"); return accept; }
            if event.text == Key.Delete { root.button-pressed("CE"); return accept; }
            if event.text == Key.Escape { root.button-pressed(root.clear-label); return accept; }
        } else if root.active-view == "converter" {
            if event.text == "0" { root.converter-button-pressed("0"); return accept; }
            if event.text == "1" { root.converter-button-pressed("1"); return accept; }
            if event.text == "2" { root.converter-button-pressed("2"); return accept; }
            if event.text == "3" { root.converter-button-pressed("3"); return accept; }
            if event.text == "4" { root.converter-button-pressed("4"); return accept; }
            if event.text == "5" { root.converter-button-pressed("5"); return accept; }
            if event.text == "6" { root.converter-button-pressed("6"); return accept; }
            if event.text == "7" { root.converter-button-pressed("7"); return accept; }
            if event.text == "8" { root.converter-button-pressed("8"); return accept; }
            if event.text == "9" { root.converter-button-pressed("9"); return accept; }
            if event.text == "." { root.converter-button-pressed("."); return accept; }
            if event.text == Key.Backspace { root.converter-button-pressed("Back"); return accept; }
            if event.text == Key.Delete || event.text == Key.Escape { root.converter-button-pressed("CE"); return accept; }
        }
        return reject;
    }

    VerticalLayout {
        content := Rectangle {
            min-width: root.history-open ? root.expanded-min-width : root.min-window-width;
            min-height: root.min-window-height;
            preferred-width: root.default-width;
            preferred-height: root.default-height;
            max-width: root.max-window-width;
            max-height: root.max-window-height;
            background: #202020;

            keyboard-focus := FocusScope {
                width: parent.width;
                height: parent.height;
                capture-key-pressed(event) => {
                    return root.handle-key(event);
                }

                Rectangle {
                    width: parent.width;
                    height: parent.height;
                    background: #202020;

                    IconButton { x: root.toolbar-margin; y: 8px; kind: "menu"; clicked => { root.sidebar-open = !root.sidebar-open; } }

                    Text {
                        x: 56px;
                        y: 8px;
                        width: root.content-width - 128px;
                        height: 36px;
                        text: root.active-view == "calculator" ? "Calculator" : root.active-view == "converter" ? root.category-title : root.active-view == "about" ? "About" : "Keyboard shortcuts";
                        color: #ffffff;
                        font-size: 19px;
                        font-family: "Inter";
                        font-weight: 600;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    if root.active-view == "calculator": IconButton { x: root.content-width - root.toolbar-margin - 40px; y: 8px; kind: "history"; clicked => { root.toggle-history(); } }

                    if root.active-view == "converter": Rectangle {
                        x: root.window-width - root.toolbar-margin - 64px;
                        y: 11px;
                        width: 64px;
                        height: 30px;
                        border-radius: 4px;
                        background: swap-touch.pressed ? #5b5b5b : swap-touch.has-hover ? #4a4a4a : #323232;

                        swap-touch := TouchArea { width: parent.width; height: parent.height; clicked => { root.swap-units-pressed(); } }

                        Text {
                            width: parent.width;
                            height: parent.height;
                            text: "Swap";
                            color: #ffffff;
                            font-size: 12px;
                            font-family: "Inter";
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    if root.active-view == "calculator": CalculatorView {
                        width: root.content-width;
                        height: parent.height - 50px;
                        margin: root.margin;
                        display-margin: root.display-margin;
                        gap: root.gap;
                        key-width: root.key-width;
                        memory-width: root.memory-width;
                        display-text: root.display-text;
                        equation-text: root.equation-text;
                        active-operator: root.active-operator;
                        clear-label: root.clear-label;
                        display-font-size: root.display-font-size;
                        button-pressed(label) => { root.button-pressed(label); }
                    }

                    if root.active-view == "calculator" && root.history-open: HistoryPanel {
                        x: root.content-width;
                        y: 0px;
                        width: root.history-panel-width;
                        height: parent.height;
                        equations: root.history-equations;
                        results: root.history-results;
                        clear-history-requested => { root.clear-history-requested(); }
                    }

                    if root.active-view == "converter": ConverterView {
                        width: parent.width;
                        height: parent.height - 50px;
                        margin: root.margin;
                        gap: root.gap;
                        converter-key-width: root.converter-key-width;
                        converter-wide-key-width: root.converter-wide-key-width;
                        input-value: root.input-value;
                        output-value: root.output-value;
                        from-unit-index <=> root.from-unit-index;
                        to-unit-index <=> root.to-unit-index;
                        unit-options: root.unit-options;
                        relation-text: root.relation-text;
                        converter-button-pressed(label) => { root.converter-button-pressed(label); }
                        from-unit-selected(value) => { root.from-unit-selected(value); }
                        to-unit-selected(value) => { root.to-unit-selected(value); }
                    }

                    if root.active-view == "shortcuts": ShortcutsView {
                        width: root.content-width;
                        height: parent.height - 50px;
                        margin: root.margin;
                    }

                    if root.active-view == "about": AboutView {
                        width: root.content-width;
                        height: parent.height - 50px;
                        margin: root.margin;
                    }

                    if root.sidebar-open: Sidebar {
                        x: 0px;
                        y: 0px;
                        width: root.window-width < 324px ? root.window-width : 324px;
                        height: root.height;
                        active-view: root.active-view;
                        category-title: root.category-title;
                        standard-selected => { root.standard-selected(); }
                        category-selected(category) => { root.collapse-history(); root.category-selected(category); }
                        shortcuts-selected => { root.collapse-history(); root.shortcuts-selected(); }
                        about-selected => { root.collapse-history(); root.active-view = "about"; root.sidebar-open = false; }
                    }
                }
            }
        }
    }

    init => {
        keyboard-focus.focus();
    }
}
