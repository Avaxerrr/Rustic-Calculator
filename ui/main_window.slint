import "../assets/fonts/Inter-Variable.ttf";

component IconButton {
    in property <string> kind;
    callback clicked();

    width: 40px;
    height: 36px;

    Rectangle {
        width: parent.width;
        height: parent.height;
        border-radius: 4px;
        background: touch.pressed ? #3a3a3a : touch.has-hover ? #303030 : #202020;

        touch := TouchArea { width: parent.width; height: parent.height; clicked => { root.clicked(); } }

        if root.kind == "menu": Path {
            x: 8px;
            y: 8px;
            width: 22px;
            height: 16px;
            commands: "M 0 1 L 22 1 M 0 8 L 22 8 M 0 15 L 22 15";
            stroke: #f2f2f2;
            stroke-width: 2px;
            stroke-line-cap: square;
            anti-alias: true;
        }

        if root.kind == "history": Path {
            x: 8px;
            y: 6px;
            width: 24px;
            height: 24px;
            commands: "M 22 12 A 10 10 0 1 1 21.99 11.5 M 12 7 L 12 12 L 16.5 15";
            stroke: #f2f2f2;
            stroke-width: 2px;
            stroke-line-cap: square;
            stroke-line-join: miter;
            fill: transparent;
            anti-alias: true;
        }
    }
}

component MemoryButton {
    in property <string> label;
    in property <length> button-width;
    in property <bool> enabled: false;
    callback clicked();

    width: root.button-width;
    height: 32px;

    Rectangle {
        width: parent.width;
        height: parent.height;
        border-radius: 4px;
        background: root.enabled ? (touch.pressed ? #343434 : touch.has-hover ? #2c2c2c : #202020) : #202020;

        touch := TouchArea { width: parent.width; height: parent.height; clicked => { root.clicked(); } }

        Text {
            text: root.label;
            color: root.enabled ? #f2f2f2 : #7f7f7f;
            font-size: 12px;
            font-family: "Inter";
            font-weight: 600;
            horizontal-alignment: center;
            vertical-alignment: center;
            width: parent.width;
            height: parent.height;
        }
    }
}

component CalcButton {
    in property <string> label;
    in property <length> button-width;
    in property <bool> operation: false;
    in property <bool> equal: false;
    in property <bool> active: false;
    property <bool> has-icon: root.label == "Back";
    property <string> visual-label: root.label == "x" ? "×" : root.label == "/" ? "÷" : root.label == "sqrt" ? "√x" : root.label == "x^2" ? "x²" : root.label;
    callback clicked();

    width: root.button-width;
    height: 58px;

    Rectangle {
        width: parent.width;
        height: parent.height;
        border-radius: 4px;
        background: touch.pressed
            ? (root.equal ? #6a6a6a : #464646)
            : root.active
                ? #4a4a4a
                : touch.has-hover
                    ? (root.equal ? #5b5b5b : root.operation ? #383838 : #3b3b3b)
                    : root.equal
                        ? #515151
                        : root.operation
                            ? #2b2b2b
                            : #323232;
        border-width: root.active ? 1px : 0px;
        border-color: #767676;

        touch := TouchArea { width: parent.width; height: parent.height; clicked => { root.clicked(); } }

        if !root.has-icon: Text {
            text: root.visual-label;
            color: #ffffff;
            font-size: 18px;
            font-family: "Inter";
            font-weight: root.operation ? 400 : 500;
            horizontal-alignment: center;
            vertical-alignment: center;
            width: parent.width;
            height: parent.height;
        }

        if root.label == "Back": Path {
            x: (parent.width - 20px) / 2;
            y: 19px;
            width: 20px;
            height: 20px;
            commands: "M 20 5 L 8 5 L 3 10 L 8 15 L 20 15 Z M 10 7.5 L 15 12.5 M 15 7.5 L 10 12.5";
            stroke: #f2f2f2;
            stroke-width: 2px;
            stroke-line-cap: square;
            stroke-line-join: miter;
            fill: transparent;
            anti-alias: true;
        }
    }
}

export component MainWindow inherits Window {
    in property <string> display-text: "0";
    in property <string> equation-text: "";
    in property <string> active-operator: "";
    in property <string> clear-label: "AC";
    callback button-pressed(string);
    in property <int> display-font-size: 52;

    title: "Rustic Calculator";
    width: 400px;
    height: 620px;
    background: #202020;
    default-font-family: "Inter";
    forward-focus: keyboard-focus;

    property <length> margin: 8px;
    property <length> display-margin: 18px;
    property <length> toolbar-margin: 16px;
    property <length> gap: 3px;
    property <length> key-width: (root.width - (root.margin * 2) - (root.gap * 3)) / 4;
    property <length> memory-width: (root.width - (root.margin * 2) - (root.gap * 5)) / 6;

    function handle-key(event: KeyEvent) -> EventResult {
        if event.text == "0" { root.button-pressed("0"); return accept; }
        if event.text == "1" { root.button-pressed("1"); return accept; }
        if event.text == "2" { root.button-pressed("2"); return accept; }
        if event.text == "3" { root.button-pressed("3"); return accept; }
        if event.text == "4" { root.button-pressed("4"); return accept; }
        if event.text == "5" { root.button-pressed("5"); return accept; }
        if event.text == "6" { root.button-pressed("6"); return accept; }
        if event.text == "7" { root.button-pressed("7"); return accept; }
        if event.text == "8" { root.button-pressed("8"); return accept; }
        if event.text == "9" { root.button-pressed("9"); return accept; }
        if event.text == "." { root.button-pressed("."); return accept; }
        if event.text == "+" { root.button-pressed("+"); return accept; }
        if event.text == "-" { root.button-pressed("-"); return accept; }
        if event.text == "*" { root.button-pressed("x"); return accept; }
        if event.text == "/" { root.button-pressed("/"); return accept; }
        if event.text == "%" { root.button-pressed("%"); return accept; }
        if event.text == "=" || event.text == Key.Return { root.button-pressed("="); return accept; }
        if event.text == Key.Backspace { root.button-pressed("Back"); return accept; }
        if event.text == Key.Delete { root.button-pressed("CE"); return accept; }
        if event.text == Key.Escape { root.button-pressed(root.clear-label); return accept; }
        return reject;
    }

    keyboard-focus := FocusScope {
        width: root.width;
        height: root.height;
        capture-key-pressed(event) => {
            return root.handle-key(event);
        }

        Rectangle {
            width: parent.width;
            height: parent.height;
            background: #202020;

        IconButton { x: root.toolbar-margin; y: 8px; kind: "menu"; clicked => { } }

        Text {
            x: 56px;
            y: 8px;
            width: root.width - 120px;
            height: 36px;
            text: "Standard";
            color: #ffffff;
            font-size: 19px;
            font-family: "Inter";
            font-weight: 600;
            vertical-alignment: center;
        }

        IconButton { x: root.width - root.toolbar-margin - 40px; y: 8px; kind: "history"; clicked => { } }

        Text {
            x: root.display-margin;
            y: 66px;
            width: root.width - root.display-margin * 2;
            height: 24px;
            text: root.equation-text;
            color: #a6a6a6;
            font-size: 14px;
            font-family: "Inter";
            horizontal-alignment: right;
            vertical-alignment: center;
            overflow: elide;
        }

        Text {
            x: root.display-margin;
            y: 96px;
            width: root.width - root.display-margin * 2;
            height: 78px;
            text: root.display-text;
            color: #ffffff;
            font-size: root.display-font-size * 1px;
            font-family: "Inter";
            font-weight: 500;
            horizontal-alignment: right;
            vertical-alignment: center;
            overflow: elide;
        }

        MemoryButton { x: root.margin + 0 * (root.memory-width + root.gap); y: 194px; button-width: root.memory-width; label: "MC"; clicked => { } }
        MemoryButton { x: root.margin + 1 * (root.memory-width + root.gap); y: 194px; button-width: root.memory-width; label: "MR"; clicked => { } }
        MemoryButton { x: root.margin + 2 * (root.memory-width + root.gap); y: 194px; button-width: root.memory-width; label: "M+"; enabled: true; clicked => { } }
        MemoryButton { x: root.margin + 3 * (root.memory-width + root.gap); y: 194px; button-width: root.memory-width; label: "M-"; enabled: true; clicked => { } }
        MemoryButton { x: root.margin + 4 * (root.memory-width + root.gap); y: 194px; button-width: root.memory-width; label: "MS"; enabled: true; clicked => { } }
        MemoryButton { x: root.margin + 5 * (root.memory-width + root.gap); y: 194px; button-width: root.memory-width; label: "M"; clicked => { } }

        CalcButton { x: root.margin + 0 * (root.key-width + root.gap); y: 249px; button-width: root.key-width; label: "%"; operation: true; clicked => { root.button-pressed("%"); } }
        CalcButton { x: root.margin + 1 * (root.key-width + root.gap); y: 249px; button-width: root.key-width; label: "CE"; operation: true; clicked => { root.button-pressed("CE"); } }
        CalcButton { x: root.margin + 2 * (root.key-width + root.gap); y: 249px; button-width: root.key-width; label: root.clear-label; operation: true; clicked => { root.button-pressed(root.clear-label); } }
        CalcButton { x: root.margin + 3 * (root.key-width + root.gap); y: 249px; button-width: root.key-width; label: "Back"; operation: true; clicked => { root.button-pressed("Back"); } }

        CalcButton { x: root.margin + 0 * (root.key-width + root.gap); y: 310px; button-width: root.key-width; label: "1/x"; operation: true; clicked => { } }
        CalcButton { x: root.margin + 1 * (root.key-width + root.gap); y: 310px; button-width: root.key-width; label: "x^2"; operation: true; clicked => { } }
        CalcButton { x: root.margin + 2 * (root.key-width + root.gap); y: 310px; button-width: root.key-width; label: "sqrt"; operation: true; clicked => { } }
        CalcButton { x: root.margin + 3 * (root.key-width + root.gap); y: 310px; button-width: root.key-width; label: "/"; operation: true; active: root.active-operator == "/"; clicked => { root.button-pressed("/"); } }

        CalcButton { x: root.margin + 0 * (root.key-width + root.gap); y: 371px; button-width: root.key-width; label: "7"; clicked => { root.button-pressed("7"); } }
        CalcButton { x: root.margin + 1 * (root.key-width + root.gap); y: 371px; button-width: root.key-width; label: "8"; clicked => { root.button-pressed("8"); } }
        CalcButton { x: root.margin + 2 * (root.key-width + root.gap); y: 371px; button-width: root.key-width; label: "9"; clicked => { root.button-pressed("9"); } }
        CalcButton { x: root.margin + 3 * (root.key-width + root.gap); y: 371px; button-width: root.key-width; label: "x"; operation: true; active: root.active-operator == "x"; clicked => { root.button-pressed("x"); } }

        CalcButton { x: root.margin + 0 * (root.key-width + root.gap); y: 432px; button-width: root.key-width; label: "4"; clicked => { root.button-pressed("4"); } }
        CalcButton { x: root.margin + 1 * (root.key-width + root.gap); y: 432px; button-width: root.key-width; label: "5"; clicked => { root.button-pressed("5"); } }
        CalcButton { x: root.margin + 2 * (root.key-width + root.gap); y: 432px; button-width: root.key-width; label: "6"; clicked => { root.button-pressed("6"); } }
        CalcButton { x: root.margin + 3 * (root.key-width + root.gap); y: 432px; button-width: root.key-width; label: "-"; operation: true; active: root.active-operator == "-"; clicked => { root.button-pressed("-"); } }

        CalcButton { x: root.margin + 0 * (root.key-width + root.gap); y: 493px; button-width: root.key-width; label: "1"; clicked => { root.button-pressed("1"); } }
        CalcButton { x: root.margin + 1 * (root.key-width + root.gap); y: 493px; button-width: root.key-width; label: "2"; clicked => { root.button-pressed("2"); } }
        CalcButton { x: root.margin + 2 * (root.key-width + root.gap); y: 493px; button-width: root.key-width; label: "3"; clicked => { root.button-pressed("3"); } }
        CalcButton { x: root.margin + 3 * (root.key-width + root.gap); y: 493px; button-width: root.key-width; label: "+"; operation: true; active: root.active-operator == "+"; clicked => { root.button-pressed("+"); } }

        CalcButton { x: root.margin + 0 * (root.key-width + root.gap); y: 554px; button-width: root.key-width; label: "+/-"; clicked => { root.button-pressed("+/-"); } }
        CalcButton { x: root.margin + 1 * (root.key-width + root.gap); y: 554px; button-width: root.key-width; label: "0"; clicked => { root.button-pressed("0"); } }
        CalcButton { x: root.margin + 2 * (root.key-width + root.gap); y: 554px; button-width: root.key-width; label: "."; clicked => { root.button-pressed("."); } }
        CalcButton { x: root.margin + 3 * (root.key-width + root.gap); y: 554px; button-width: root.key-width; label: "="; equal: true; clicked => { root.button-pressed("="); } }

        }
    }

    init => {
        keyboard-focus.focus();
    }
}
