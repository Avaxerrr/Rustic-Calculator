export component TextDropdown {
    in property <[string]> model;
    in-out property <int> current-index: 0;
    callback selected(string);

    width: 150px;
    height: 34px;

    property <string> current-value: root.current-index >= 0 && root.current-index < root.model.length ? root.model[root.current-index] : "";
    property <int> visible-count: min(8, root.model.length);

    Rectangle {
        width: parent.width;
        height: parent.height;
        border-radius: 4px;
        background: #00000000;

        touch := TouchArea {
            width: parent.width;
            height: parent.height;
            clicked => { popup.show(); }
        }

        HorizontalLayout {
            x: 0px;
            y: 0px;
            width: root.width;
            height: root.height;
            spacing: 6px;
            alignment: start;

            Text {
                max-width: root.width - 24px;
                height: root.height;
                text: root.current-value;
                color: touch.pressed || touch.has-hover ? #ffffff : #d8d8d8;
                font-size: 15px;
                font-family: "Inter";
                font-weight: 500;
                vertical-alignment: center;
                overflow: elide;
            }

            Text {
                width: 16px;
                height: root.height;
                text: "⌄";
                color: touch.pressed || touch.has-hover ? #ffffff : #a6a6a6;
                font-size: 16px;
                font-family: "Inter";
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }

    popup := PopupWindow {
        x: 0px;
        y: root.height + 2px;
        width: 240px;
        height: root.visible-count * 32px + 8px;
        close-policy: close-on-click-outside;

        Rectangle {
            width: parent.width;
            height: parent.height;
            border-radius: 6px;
            border-width: 1px;
            border-color: #3b3b3b;
            background: #252525;

            Flickable {
                x: 4px;
                y: 4px;
                width: parent.width - 8px;
                height: parent.height - 8px;
                viewport-height: root.model.length * 32px;
                interactive: root.model.length > root.visible-count;

                for value[index] in root.model : Rectangle {
                    y: index * 32px;
                    width: parent.width;
                    height: 32px;
                    border-radius: 4px;
                    background: #00000000;

                    option-touch := TouchArea {
                        width: parent.width;
                        height: parent.height;
                        clicked => {
                            root.current-index = index;
                            root.selected(value);
                            popup.close();
                        }
                    }

                    Text {
                        x: 12px;
                        width: parent.width - 20px;
                        height: parent.height;
                        text: value;
                        color: index == root.current-index ? #7dd3fc : option-touch.has-hover ? #ffffff : #d8d8d8;
                        font-size: 13px;
                        font-family: "Inter";
                        font-weight: index == root.current-index ? 700 : 500;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
            }
        }
    }
}
